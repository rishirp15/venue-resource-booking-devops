# Venue Booking System - Environment Variables Template
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=venuedb
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Connection Pool Settings
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
SESSION_COOKIE_SECURE=false
