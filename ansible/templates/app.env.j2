# ==============================================================================
# Venue Resource Booking System - Container Environment Configuration
# Managed by Ansible - Generated from app.env.j2 template
# ==============================================================================
SERVER_PORT={{ container_port }}
SPRING_PROFILES_ACTIVE={{ spring_profile }}
JAVA_OPTS={{ java_opts }}

# Storage & Database Configuration
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/venuedb
{% if spring_profile == 'prod' %}
DB_HOST={{ db_host | default('localhost') }}
DB_PORT={{ db_port | default('5432') }}
DB_NAME={{ db_name | default('venuedb') }}
DB_USER={{ db_user | default('postgres') }}
DB_PASSWORD={{ db_password | default('') }}
{% endif %}

# Session and Security
SESSION_COOKIE_SECURE=false

# Optional Email Notifications
EMAIL_ENABLED={{ email_enabled | default('false') }}
